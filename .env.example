# Local/server defaults. Web users can override keys for their session in the sidebar.
# Restart Streamlit after editing .env to reload these defaults.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini-search-preview
OPENAI_TIMEOUT_SECONDS=45
OPENAI_BATCH_SIZE=10
MAX_COMPANIES_PER_RUN=

# People search: Serper retrieval, OpenAI role classification, deterministic filtering.
SERPER_API_KEY=
OPENAI_PEOPLE_MODEL=gpt-5-mini
PEOPLE_TIMEOUT_SECONDS=90
PEOPLE_MAX_QUERIES_PER_COMPANY=4
PEOPLE_MAX_CANDIDATES=40
# Additional attempts only for temporary model errors; 0 disables automatic retries.
PEOPLE_LLM_MAX_RETRIES=2
